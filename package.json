    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "obsidian": "^1.14.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
